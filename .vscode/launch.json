{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GamePi: set up the machine",
      "type": "node-terminal",
      "request": "launch",
      "command": "bash \"${workspaceFolder}/setup.sh\"",
      "windows": {
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"bash \\\"${workspaceFolder}/setup.sh\\\"\""
      },
      "cwd": "${workspaceFolder}",
      "presentation": {
        "group": "gamepi",
        "order": 1
      }
    }
  ]
}