{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GamePi: set up the machine",
      "type": "process",
      "command": "bash",
      "args": ["${workspaceFolder}/setup.sh"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-Command",
          "bash \"${workspaceFolder}/setup.sh\""
        ]
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "problemMatcher": []
    }
  ]
}